            "event.description",
            "event.behavior",
            "state.emotion",
            "state.energy",
            "state.stress",
            "state.attention",
            "state.cognitive_load",
            "state.position",
            "state.intention",
            "state.life_context",
            "state.resources",
            "preference.communication",
            "boundary.explicit",
            "goal.current",
            "antigoal.current",
            "identity.role",
            "relationship.expectation",
            "hypothesis.contextual_pattern",
            "capability.self_evaluation",
            "value.user_defined"
          ]
        },
        "epistemic_status": {
          "enum": [
            "reported",
            "inferred"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "text"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "kind",
                "text"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "reference"
                },
                "ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "entity_type": {
                      "enum": [
                        "source",
                        "evidence",
                        "claim",
                        "event",
                        "behavior",
                        "memory",
                        "relationship",
                        "issue",
                        "action",
                        "outcome",
                        "conversation",
                        "person",
                        "proposal"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32,
                      "pattern": "^[1-9][0-9]*$"
                    }
                  },
                  "required": [
                    "entity_type",
                    "id",
                    "revision"
                  ]
                }
              },
              "required": [
                "kind",
                "ref"
              ]
            },
            {
              "type": "null"
            }
