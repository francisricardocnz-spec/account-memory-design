          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]{8,128}$"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "valid_time": {
          "$ref": "#/$defs/ValidTime"
        },
        "support": {
          "enum": [
            "insufficient",
            "provisional",
            "supported",
            "corroborated"
