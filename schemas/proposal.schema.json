{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/account-memory/proposal.schema.json",
  "title": "Untrusted model extraction proposal, public design v0.2",
  "description": "Structure example for initially enabled fields only. Does not validate real authority, source authenticity, source ownership or activation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "proposal_id",
    "source_bindings",
    "claims"
  ],
  "properties": {
    "contract_version": {
      "const": "memory-proposal-public-v0.2"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "source_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceBinding"
      },
      "minItems": 1,
      "maxItems": 32
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClaimCandidate"
      },
      "minItems": 0,
      "maxItems": 32
    }
  },
  "$defs": {
    "SourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[1-9][0-9]*$"
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coordinate_unit": {
              "const": "unicode_code_point"
            },
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "end": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            }
          },
          "required": [
            "coordinate_unit",
            "start",
            "end"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "source_handle",
        "source_revision",
        "locator",
        "quote"
      ]
    },
    "ClaimCandidate": {
